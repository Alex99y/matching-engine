# ── ME connection ─────────────────────────────────────────────────────────────
ME_HOST=localhost
ME_PORT=4000
ME_INSECURE=true
ME_USERNAME=bob
ME_PASSWORD=bobpass123456

# ── Market mapping ─────────────────────────────────────────────────────────────
ME_MARKET=BTC-USDT
BINANCE_SYMBOL=btcusdt

# ── Depth config ───────────────────────────────────────────────────────────────
# Levels fetched from Binance (5 | 10 | 20)
BINANCE_DEPTH_LEVELS=20
# Levels the bot mirrors into the ME (must be ≤ BINANCE_DEPTH_LEVELS)
BOT_LEVELS=5

# ── Tolerance (skip update if change is below these thresholds) ────────────────
# 0.00005 = 0.005% price movement (~$3.20 on $64k BTC)
# The old 0.1% (~$64) was far too wide: a $17 market move fell within tolerance,
# so stale asks/bids at old prices would never be refreshed organically.
BOT_PRICE_TOLERANCE=0.00005
# 0.20 = 20% quantity change
BOT_QTY_TOLERANCE=0.20

# ── Timing ─────────────────────────────────────────────────────────────────────
# Minimum ms between reconcile triggers from the Binance WS
BOT_COOLDOWN_MS=500
# Interval for the ME open-order poll that detects fills
BOT_RECONCILE_INTERVAL_MS=2000

# ── Dev ────────────────────────────────────────────────────────────────────────
# Logs what would be placed/cancelled without touching the ME
BOT_DRY_RUN=false
# debug | info | warn | error
LOG_LEVEL=error
