# The seed job: the cli binary plus a shell to drive it. The cli's own image is FROM scratch,
# which cannot run a script, so this rebuilds the binary onto a minimal shell image.
#
# Build context must be the workspace root:
#   docker build -f e2e/Dockerfile.seed -t matching-engine/e2e-seed .
# Run `go work vendor` at the workspace root before building.

FROM golang:1.25-alpine AS builder
WORKDIR /workspace

COPY api/go.mod api/go.sum api/
COPY cli/go.mod cli/go.sum cli/
COPY common/go.mod common/go.sum common/
COPY core/go.mod core/go.sum core/
COPY db/go.mod db/go.sum db/
COPY vendor/ vendor/

# Declare the workspace this image needs rather than copying the repo's go.work. Go loads
# every module a workspace lists, so inheriting it would tie this image to modules it never
# references — and break the build whenever one is added to the repo.
RUN go work init ./api ./cli ./common ./core ./db

COPY cli/ cli/
COPY common/ common/
COPY db/ db/

RUN CGO_ENABLED=0 GOOS=linux go build -mod=vendor -ldflags="-s -w" -o /bin/cli ./cli/cmd


FROM alpine:3.20
COPY --from=builder /bin/cli /bin/cli
COPY infra/scripts/seed.sh /seed.sh
ENTRYPOINT ["/bin/sh", "/seed.sh"]
